<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="#4CAF50"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvModalTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Detail Resi JNE (Belum Kirim)"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCloseModal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✕"
            android:textColor="@android:color/white"
            android:background="@android:color/transparent"
            android:textSize="20sp"
            android:minWidth="48dp"
            android:minHeight="48dp" />

    </LinearLayout>

    <!-- Table Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#F3F4F6"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.5"
            android:text="Resi"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#374151" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Order"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#374151" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Channel"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#374151" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Courier"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#374151" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:text="Created"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#374151" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Date Trans"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#374151" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.8"
            android:text="Flag"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#374151" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.8"
            android:text="CEKFU"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#374151" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.8"
            android:text="Karung"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#374151" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Schedule"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#374151" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:text="Keterangan"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#374151" />

    </LinearLayout>

    <!-- RecyclerView untuk data resi -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvResiDetails"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical" />

    <!-- Footer dengan action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#F9FAFB">

        <!-- Action buttons row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnExportData"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="📋 Export"
                android:background="@drawable/button_secondary"
                android:textColor="#374151"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnRefreshData"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="🔄 Refresh"
                android:background="@drawable/button_primary"
                android:textColor="@android:color/white"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Action buttons row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnBatalResi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="❌ Batal Resi"
                android:background="@drawable/button_secondary"
                android:textColor="#EF4444"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnConfirmResi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="✅ Confirm"
                android:background="@drawable/button_secondary"
                android:textColor="#10B981"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
