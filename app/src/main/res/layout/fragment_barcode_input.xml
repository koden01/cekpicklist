<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9FAFB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Main Card - Gradient Background (Sama dengan web app) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#4CAF50">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center">

                <!-- Title + Sync -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Input Data Resi"
                        android:textColor="@android:color/white"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnSyncBarcode"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@android:color/transparent"
                        android:padding="4dp"
                        android:contentDescription="@string/sync_master_data"
                        android:src="@drawable/ic_sync"
                        android:tint="@android:color/white" />
                </LinearLayout>

                <!-- Count Display (Besar seperti web app) -->
                <TextView
                    android:id="@+id/tvScanCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@android:color/white"
                    android:textSize="48sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <!-- Expedition Info (Clickable seperti web app) -->
                <TextView
                    android:id="@+id/tvSelectedExpedisi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pilih Expedisi"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginBottom="8dp" />

                <!-- Summary Info (Sama dengan web app) -->
                <TextView
                    android:id="@+id/tvSummaryInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total: 0 - Scan: 0 - Sisa: 0"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:alpha="0.8"
                    android:layout_marginBottom="24dp" />

                <!-- Form Grid (2 kolom seperti web app) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Row 1: Expedition dan Karung -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <!-- Expedition Selection -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Expedisi"
                                android:textColor="@android:color/white"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="8dp" />

                            <Spinner
                                android:id="@+id/spinnerExpedisi"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:background="@drawable/select_background_white"
                                android:padding="12dp" />

                        </LinearLayout>

                        <!-- Karung Selection -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="No Karung"
                                android:textColor="@android:color/white"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="8dp" />

                            <Spinner
                                android:id="@+id/spinnerKarung"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:background="@drawable/select_background_white"
                                android:padding="12dp" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Row 2: Scan Input (Full width seperti web app) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Scan Resi"
                            android:textColor="@android:color/white"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <EditText
                                android:id="@+id/etBarcodeInput"
                                android:layout_width="match_parent"
                                android:layout_height="64dp"
                                android:background="@drawable/input_background_white"
                                android:padding="16dp"
                                android:hint="Scan nomor resi"
                                android:inputType="text"
                                android:imeOptions="actionDone"
                                android:textSize="18sp"
                                android:gravity="center"
                                android:textColor="#374151" />

                            <!-- Loading indicator (sama dengan web app) -->
                            <ProgressBar
                                android:id="@+id/progressBar"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="end|center_vertical"
                                android:layout_marginEnd="16dp"
                                android:visibility="gone"
                                android:indeterminateTint="@android:color/white" />

                        </FrameLayout>

                        <!-- Transaksi hari ini (unique resi di tbl_expedisi) -->
                        <TextView
                            android:id="@+id/tvTodayUnique"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Transaksi hari ini: 0 unik"
                            android:textColor="@android:color/white"
                            android:textSize="14sp"
                            android:alpha="0.85"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="8dp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>
